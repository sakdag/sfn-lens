  },
  "definition": {
    "Comment": "sfn-lens demo — cheap fault-injection workflow",
    "StartAt": "Validate",
    "States": {
      "Validate": {
        "Type": "Task",
        "Resource": "arn:aws:lambda:eu-north-1:000000000000:function:sfn-lens-demo",
        "Parameters": {
          "step": "validate",
          "fault.$": "$.fault"
        },
        "Next": "Route"
      },
      "Route": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.fault",
            "StringEquals": "reject",
            "Next": "Reject"
          }
        ],
        "Default": "MaybeMap"
      },
      "MaybeMap": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.fault",
            "StringEquals": "map_partial",
            "Next": "ProcessMap"
          }
        ],
        "Default": "Process"
      },
      "ProcessMap": {
        "Type": "Map",
        "ItemsPath": "$.items",
        "MaxConcurrency": 2,
        "Iterator": {
          "StartAt": "MapItem",
          "States": {
            "MapItem": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:eu-north-1:000000000000:function:sfn-lens-demo",
              "Parameters": {
                "step": "map_item",
                "item.$": "$"
              },
              "End": true
            }
          }
        },
        "Next": "Done"
      },
      "Process": {
        "Type": "Task",
        "Resource": "arn:aws:lambda:eu-north-1:000000000000:function:sfn-lens-demo",
        "Parameters": {
          "step": "process",
          "fault.$": "$.fault"
        },
        "Retry": [
          {
            "ErrorEquals": [
              "States.ALL"
            ],
            "IntervalSeconds": 1,
            "MaxAttempts": 2,
            "BackoffRate": 1.5
          }
        ],
        "Catch": [
          {
            "ErrorEquals": [
              "States.ALL"
            ],
            "Next": "HandleError",
            "ResultPath": "$.error"
          }
        ],
        "Next": "Done"
      },
      "HandleError": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.fault",
            "StringEquals": "caught_then_fail",
            "Next": "FailAfterCatch"
          }
        ],
        "Default": "Done"
      },
      "FailAfterCatch": {
        "Type": "Fail",
        "Error": "CaughtThenFailed",
        "Cause": "recovered from task error then failed deliberately"
      },
      "Reject": {
        "Type": "Fail",
        "Error": "Rejected",
        "Cause": "validation rejected"
      },
      "Done": {
        "Type": "Succeed"
      }
    }
  },
